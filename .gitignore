# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── Distribution / packaging ────────────────────────────────────────
.Python
build/
dist/
*.egg-info/
*.egg

# ── Virtual environments ────────────────────────────────────────────
.venv/
venv/
env/

# ── Test + coverage ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache/

# ── IDEs / editors ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
bookworm-lite-arm64.img


# ── Runtime + local state (lives in /var/microjs8/ on the Pi, not here) 
# Including these in the repo would leak callsign/grid/QSO data.
*.db
*.db-journal
*.log
config.local.toml
*.local.toml

# ── Iteration artifacts ─────────────────────────────────────────────
*.tar.gz
*.tgz

# ── Native libs / compiled extensions (built per-host) ──────────────
*.so
*.dylib
*.dll

# ── gfsk8 working trees if cloned alongside (use the upstream fork) ─
/gfsk8-modem-clean*/
/gfsk8/


# Build output (build.sh writes intermediate artifacts here)
/output/
