[Unit]
Description=MiniJS8 JS8 transceiver
Documentation=file:///opt/minijs8/README.md
After=local-fs.target sound.target time-sync.target gpsd.socket rigctld.service
# Soft dependencies: minijs8 starts even when these aren't running.
# In particular, rigctld may not be running if the QDX isn't plugged
# in — minijs8 stays up in receive-only mode and the CAT layer is
# best-effort (frequency edits fail, no TX possible).
Wants=time-sync.target gpsd.socket rigctld.service

# StartLimitBurst / StartLimitIntervalSec — cap how many times we'll
# restart in the given window before giving up. 5 restarts in 5 min
# covers genuine crash loops without giving up too early on
# intentional Setup-driven exits.
#
# These directives belong in [Unit], NOT [Service] — older docs and
# many forum posts get this wrong. Putting them in [Service] makes
# systemd log "Unknown key 'StartLimitIntervalSec' in section
# [Service], ignoring." and the rate-limit window silently falls
# back to the default. Verified on Bookworm (systemd 252).
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=minijs8
Group=minijs8
SupplementaryGroups=audio dialout gpio spi input

# Run from a writable location. lgpio (the gpiozero backend on Bookworm)
# creates a per-process notify FIFO at `${CWD}/.lgd-nfy-<pid>`; if CWD is
# read-only the GPIO event-detect path fails and gpiozero silently falls
# back to RPi.GPIO, which is broken on recent Bookworm. /var/minijs8 is
# our writable runtime dir.
WorkingDirectory=/var/minijs8

# Pin gpiozero to the lgpio backend explicitly. Without this, gpiozero
# walks a fallback chain (lgpio → rpigpio → pigpio → native) and silently
# selects something that doesn't actually work for event callbacks.
Environment=GPIOZERO_PIN_FACTORY=lgpio

# Use the baked virtualenv's Python directly. -u disables stdout/stderr
# buffering so log lines reach journald in real time instead of being
# held until the buffer flushes (critical for diagnosing crashes).
#
# The ExecStartPre line below restarts rigctld so it picks up any
# radio_id change from /var/minijs8/config.toml. The launcher script
# (run as rigctld's ExecStart) reads the config to choose its
# command line arguments — without this restart, rigctld would
# remain on whatever radio path was current when it FIRST started,
# which breaks the UI's "cycle and restart" model.
#
# Prefix legend:
#   '-' (ignore failures)  — minijs8 must come up even if rigctld
#                            can't be restarted (e.g. systemd is
#                            transiently busy). Without this we
#                            risk a chicken-and-egg scenario where
#                            both services refuse to start.
#   '+' (run as root)      — minijs8.service runs as the minijs8
#                            user, which doesn't normally have
#                            permission to call systemctl on
#                            other units. The '+' prefix tells
#                            systemd to run this command as root
#                            regardless of the User= directive.
#
# 'restart' (not 'try-restart') because rigctld may be in 'inactive
# (dead)' state — its launcher exits 0 successfully for the
# digirig-rts-only path, and try-restart skips inactive units.
# Plain restart works in both 'active' and 'inactive' cases.
ExecStartPre=-+/bin/systemctl restart rigctld
ExecStart=/opt/minijs8/venv/bin/python -u -m minijs8

# Restart on ANY exit. The daemon runs forever in normal operation
# (asyncio loop driven until SIGTERM), so this only fires for two
# reasons: (1) a real crash, and (2) an INTENTIONAL clean exit
# triggered by the operator changing the radio profile in Setup.
# The radio cycle handler in app.py calls request_stop() and the
# daemon falls out cleanly; systemd brings us back here.
Restart=always
RestartSec=5

# Graceful stop: deliver SIGTERM, give the process up to TimeoutStopSec
# to handle it, then SIGKILL. The Python signal handler in
# MiniJS8App.run() honors SIGTERM and shuts down within ~2s.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

# Sandboxing — moderate, not paranoid. We need /dev access for the
# audio device, the QDX serial port, the GPS dongle, and SPI to the
# TFT, so PrivateDevices=yes is NOT set. NoNewPrivileges and
# ProtectHome are safe and free.
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/minijs8

# Stdout / stderr go to journald.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minijs8

[Install]
WantedBy=multi-user.target
