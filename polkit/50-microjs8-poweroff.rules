// MicroJS8 — power-off / reboot polkit rule
// =========================================
//
// systemd-logind requires polkit authorization for shutdown and reboot.
// The microjs8 service user is non-interactive (no console session, no
// D-Bus user session), so the default "auth_admin_keep" rule rejects
// it with "Interactive authentication required."
//
// This rule allows the `microjs8` user (and only that user) to invoke
// the standard logind power actions without being prompted. The MicroJS8
// daemon only fires these in response to the operator pressing both
// TFT buttons for the full 5-second countdown — i.e. an explicit,
// physical, deliberate gesture — so granting the daemon this authority
// matches the operator's intent.
//
// Actions covered:
//   org.freedesktop.login1.power-off                  — `systemctl poweroff`
//   org.freedesktop.login1.power-off-multiple-sessions — same, with other users logged in
//   org.freedesktop.login1.reboot                      — `systemctl reboot`
//   org.freedesktop.login1.reboot-multiple-sessions    — same, multi-user
//
// Installation: place at /etc/polkit-1/rules.d/50-microjs8-poweroff.rules.
// File MUST end in .rules, MUST be in /etc/polkit-1/rules.d/, and MUST
// be owned root:root with 0644 permissions.

polkit.addRule(function(action, subject) {
    if (subject.user !== "microjs8") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id === "org.freedesktop.login1.power-off" ||
        action.id === "org.freedesktop.login1.power-off-multiple-sessions" ||
        action.id === "org.freedesktop.login1.reboot" ||
        action.id === "org.freedesktop.login1.reboot-multiple-sessions") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
